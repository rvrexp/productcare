@page "/products/{Id:guid}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using ProductCare.Web.Api
@using ProductCare.Web.Usage
@implements IDisposable

@attribute [Authorize]

@inject ProductCareApiClient ApiClient
@inject UsageQuotaState UsageState
@inject IJSRuntime JS

<PageTitle>Product Details | ProductCare AI</PageTitle>

@if (isLoading)
{
    <div class="pc-loading">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span>Loading product...</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="pc-error">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-circle mt-1" aria-hidden="true"></i>
            <span>@loadError</span>
        </div>
    </div>
}
else if (product is not null)
{
    <div class="pc-page-header pc-page-header-with-action">
        <div>
            <div class="pc-eyebrow">Saved product</div>
            <h1>@Display(product.ProductName)</h1>

            <p>
                @Display(product.Manufacturer)
                @if (!string.IsNullOrWhiteSpace(product.ModelNumber))
                {
                    <span> · Model @product.ModelNumber</span>
                }
            </p>
        </div>

        <a class="btn btn-outline-secondary" href="products">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back to My Products
        </a>
    </div>

    <section class="pc-panel pc-product-summary">
        <div class="pc-product-meta-grid">
            <div class="pc-meta-item">
                <span class="pc-meta-label">
                    <i class="bi bi-box-seam me-1" aria-hidden="true"></i>
                    Product
                </span>

                <span class="pc-meta-value">@Display(product.ProductName)</span>
            </div>

            <div class="pc-meta-item">
                <span class="pc-meta-label">
                    <i class="bi bi-building me-1" aria-hidden="true"></i>
                    Manufacturer
                </span>

                <span class="pc-meta-value">@Display(product.Manufacturer)</span>
            </div>

            <div class="pc-meta-item">
                <span class="pc-meta-label">
                    <i class="bi bi-upc-scan me-1" aria-hidden="true"></i>
                    Model number
                </span>

                <span class="pc-meta-value">@Display(product.ModelNumber)</span>
            </div>

            <div class="pc-meta-item">
                <span class="pc-meta-label">
                    <i class="bi bi-hash me-1" aria-hidden="true"></i>
                    Serial number
                </span>

                <span class="pc-meta-value">@Display(product.SerialNumber)</span>
            </div>
        </div>
    </section>

    <section class="pc-panel pc-assistant-panel">
        <div class="pc-section-header">
            <div>
                <div class="pc-eyebrow">
                    <i class="bi bi-stars me-1" aria-hidden="true"></i>
                    AI assistant
                </div>

                <h2>ProductCare Assistant</h2>

                <p>
                    Ask naturally about this product. ProductCare can use the product manual and other available product information when needed.
                    Follow-up questions can refer to earlier answers in this conversation.
                </p>
            </div>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="StartNewConversation"
                    disabled="@(isAskingAssistant || isStartingNewConversation)">
                @if (isStartingNewConversation)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Starting...</span>
                }
                else
                {
                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                    <span>New conversation</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(conversationNotice))
        {
            <div class="pc-success pc-section-message">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>@conversationNotice</span>
                </div>
            </div>
        }

        @if (UsageState.IsLoaded)
        {
            <div class="pc-quota-strip">
                <span>
                    <i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>
                    Daily assistant usage
                </span>

                <strong class="@(AssistantQuotaExhausted ? "text-danger" : "")">
                    @UsageState.GetRemainingText(UsageQuotaState.ProductAssistantOperation)
                </strong>
            </div>
        }

        @if (AssistantQuotaExhausted)
        {
            <div class="alert alert-warning pc-section-message">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle mt-1" aria-hidden="true"></i>

                    <div>
                        <strong>Daily assistant limit reached.</strong>
                        @ResetMessage
                    </div>
                </div>
            </div>
        }

        <div class="pc-chat" @ref="assistantChat">
            @if (assistantMessages.Count == 0 && !isAskingAssistant)
            {
                <div class="pc-chat-empty">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-2"
                         style="width: 48px; height: 48px;">
                        <i class="bi bi-chat-dots fs-5" aria-hidden="true"></i>
                    </div>

                    <strong>Start a conversation about this product.</strong>

                    <span>
                        Try asking about setup, maintenance, troubleshooting, specifications, or product safety.
                    </span>
                </div>
            }

            @foreach (AssistantChatMessage message in assistantMessages)
            {
                <div class="pc-chat-row @(message.IsAssistant ? "pc-chat-row-assistant" : "pc-chat-row-user")">
                    <div class="pc-chat-message">
                        <div class="pc-chat-author">
                            @if (message.IsAssistant)
                            {
                                <i class="bi bi-stars" aria-hidden="true"></i>
                                <span>ProductCare</span>
                            }
                            else
                            {
                                <i class="bi bi-person" aria-hidden="true"></i>
                                <span>You</span>
                            }
                        </div>

                        <div class="pc-chat-bubble @(message.IsAssistant ? "pc-chat-bubble-assistant" : "pc-chat-bubble-user")">
                            <div class="pc-chat-text">@message.Text</div>

                            @if (message.IsAssistant && message.Result is not null && message.Result.Sources.Count > 0)
                            {
                                <div class="pc-chat-sources">
                                    <div class="pc-chat-sources-title">
                                        <i class="bi bi-journal-text me-1" aria-hidden="true"></i>
                                        Sources
                                    </div>

                                    <ul class="pc-source-list">
                                        @foreach (ProductAssistantSourceResponse source in message.Result.Sources)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(source.Url))
                                                {
                                                    <a href="@source.Url" target="_blank" rel="noopener noreferrer">
                                                        @source.Title
                                                        <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span>@source.Title</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (isAskingAssistant && !string.IsNullOrWhiteSpace(streamingAssistantAnswer))
            {
                <div class="pc-chat-row pc-chat-row-assistant">
                    <div class="pc-chat-message">
                        <div class="pc-chat-author">
                            <i class="bi bi-stars" aria-hidden="true"></i>
                            <span>ProductCare</span>
                            <span class="pc-streaming-status">Responding</span>
                        </div>

                        <div class="pc-chat-bubble pc-chat-bubble-assistant">
                            <div class="pc-chat-text">@streamingAssistantAnswer</div>
                        </div>
                    </div>
                </div>
            }
            else if (isAskingAssistant)
            {
                <div class="pc-chat-row pc-chat-row-assistant">
                    <div class="pc-chat-message">
                        <div class="pc-chat-author">
                            <i class="bi bi-stars" aria-hidden="true"></i>
                            <span>ProductCare</span>
                        </div>

                        <div class="pc-chat-bubble pc-chat-bubble-assistant">
                            <div class="pc-thinking">
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Working on your question...</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <EditForm Model="@assistantModel" OnValidSubmit="AskAssistant">
            <DataAnnotationsValidator />

            <div class="pc-assistant-composer">
                <label class="form-label fw-semibold" for="productcare-assistant-message">
                    <i class="bi bi-chat-square-text me-1" aria-hidden="true"></i>
                    Ask ProductCare
                </label>

                <textarea id="productcare-assistant-message"
                          class="form-control pc-chat-input"
                          @ref="assistantTextArea"
                          @bind="assistantModel.Message"
                          @bind:event="oninput"
                          @onkeyup="HandleAssistantKeyUp"
                          rows="3"
                          maxlength="2000"
                          placeholder="For example: How do I change the ink cartridge?"
                          disabled="@(isAskingAssistant || isStartingNewConversation || AssistantQuotaExhausted)"></textarea>

                <ValidationMessage For="@(() => assistantModel.Message)" />

                <div class="pc-composer-actions">
                    <div class="d-flex flex-column gap-1">
                        <span class="pc-composer-help">
                            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                            ProductCare can use available product documentation and recall information when appropriate.
                        </span>

                        <span class="pc-composer-help">
                            Press <strong>Enter</strong> to send · <strong>Shift + Enter</strong> for a new line
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary pc-primary-button px-4"
                            disabled="@(isAskingAssistant || isStartingNewConversation || AssistantQuotaExhausted)">
                        @if (isAskingAssistant)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            <span>Thinking...</span>
                        }
                        else
                        {
                            <i class="bi bi-send me-1" aria-hidden="true"></i>
                            <span>Ask ProductCare</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(assistantError))
        {
            <div class="pc-error pc-section-message">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-circle mt-1" aria-hidden="true"></i>
                    <span>@assistantError</span>
                </div>
            </div>
        }
    </section>

    <section class="pc-panel pc-safety-panel">
        <div class="pc-section-header">
            <div>
                <div class="pc-eyebrow">
                    <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                    Product safety
                </div>

                <h2>Safety & Recalls</h2>

                <p>
                    Check this product model against the U.S. Consumer Product Safety Commission recall database.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(product.Manufacturer) && !string.IsNullOrWhiteSpace(product.ModelNumber))
            {
                <button type="button"
                        class="btn btn-outline-danger"
                        @onclick="CheckSafety"
                        disabled="@isCheckingSafety">
                    @if (isCheckingSafety)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        <span>Checking...</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>
                        <span>Check Recalls</span>
                    }
                </button>
            }
        </div>

        <div class="pc-info-note">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            Recall lookup does not use your daily AI quota.
        </div>

        @if (string.IsNullOrWhiteSpace(product.Manufacturer) || string.IsNullOrWhiteSpace(product.ModelNumber))
        {
            <div class="alert alert-warning pc-section-message">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle mt-1" aria-hidden="true"></i>

                    <span>
                        A confirmed manufacturer and model number are required before ProductCare can perform a reliable recall check.
                    </span>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(safetyError))
        {
            <div class="pc-error pc-section-message">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-circle mt-1" aria-hidden="true"></i>
                    <span>@safetyError</span>
                </div>
            </div>
        }

        @if (safetyResult is not null)
        {
            <div class="pc-safety-results">
                @if (safetyResult.Recalls.Count == 0)
                {
                    <div class="pc-success">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle mt-1" aria-hidden="true"></i>

                            <div>
                                <strong>No matching CPSC recall found.</strong>

                                <div class="mt-1">
                                    No matching recall was found for this model in the current lookup.
                                    This does not guarantee that the product is free of safety issues.
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pc-error">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                            <strong>A matching CPSC recall was found.</strong>
                        </div>
                    </div>

                    @foreach (ProductRecallResponse recall in safetyResult.Recalls)
                    {
                        <article class="pc-recall-card">
                            <div class="pc-recall-header">
                                <div>
                                    <div class="pc-recall-label">
                                        <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                                        CPSC recall
                                    </div>

                                    <h3>@recall.Title</h3>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(recall.RecallNumber))
                                {
                                    <span class="pc-recall-number">@recall.RecallNumber</span>
                                }
                            </div>

                            <div class="pc-recall-grid">
                                @if (recall.RecallDate.HasValue)
                                {
                                    <div>
                                        <span class="pc-meta-label">Recall date</span>
                                        <span class="pc-meta-value">@recall.RecallDate.Value.ToString("MMMM d, yyyy")</span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(recall.Hazard))
                                {
                                    <div>
                                        <span class="pc-meta-label">Hazard</span>
                                        <span class="pc-meta-value">@recall.Hazard</span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(recall.Remedy))
                                {
                                    <div>
                                        <span class="pc-meta-label">Remedy</span>
                                        <span class="pc-meta-value">@recall.Remedy</span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(recall.ConsumerContact))
                                {
                                    <div>
                                        <span class="pc-meta-label">Consumer contact</span>
                                        <span class="pc-meta-value">@recall.ConsumerContact</span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(recall.OfficialUrl))
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="@recall.OfficialUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>
                                    View official CPSC recall
                                </a>
                            }
                        </article>
                    }
                }

                <div class="pc-result-timestamp">
                    <i class="bi bi-clock me-1" aria-hidden="true"></i>
                    Checked @safetyResult.CheckedUtc.ToLocalTime().ToString("g")
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProductResponse? product;

    private ElementReference assistantChat;
    private ElementReference assistantTextArea;

    private readonly List<AssistantChatMessage> assistantMessages = [];
    private AssistantQuestionModel assistantModel = new();

    private bool isAskingAssistant;
    private bool isStartingNewConversation;
    private bool scrollChatAfterRender;
    private bool smoothChatScrollAfterRender;
    private bool focusAssistantAfterRender;

    private string? streamingAssistantAnswer;
    private string? assistantError;
    private string? conversationNotice;

    private ProductSafetyResponse? safetyResult;
    private bool isCheckingSafety;
    private string? safetyError;

    private bool isLoading = true;
    private string? loadError;

    private bool AssistantQuotaExhausted => UsageState.IsExhausted(UsageQuotaState.ProductAssistantOperation);

    private string ResetMessage => UsageState.Summary is null ? "The quota will be available again after the daily UTC reset." : $"The quota resets at {UsageState.Summary.ResetUtc.ToLocalTime():g} local time.";

    protected override async Task OnInitializedAsync()
    {
        UsageState.Changed += OnUsageChanged;

        try
        {
            product = await ApiClient.GetProductAsync(Id);

            if (product is null)
            {
                loadError = "Product could not be found.";
                return;
            }

            try
            {
                await UsageState.EnsureLoadedAsync();
            }
            catch
            {
                // Product details can still be used if the usage indicator temporarily fails.
            }
        }
        catch
        {
            loadError = "Product could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollChatAfterRender)
        {
            bool smooth = smoothChatScrollAfterRender;

            scrollChatAfterRender = false;
            smoothChatScrollAfterRender = false;

            await ScrollAssistantChatAsync(smooth);
        }

        if (focusAssistantAfterRender)
        {
            focusAssistantAfterRender = false;

            if (!AssistantQuotaExhausted && !isAskingAssistant && !isStartingNewConversation)
            {
                await FocusAssistantTextAreaAsync();
            }
        }
    }

    private async Task HandleAssistantKeyUp(KeyboardEventArgs args)
    {
        if (!args.Key.Equals("Enter", StringComparison.OrdinalIgnoreCase) || args.ShiftKey || isAskingAssistant || isStartingNewConversation || AssistantQuotaExhausted)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(assistantModel.Message))
        {
            return;
        }

        if (assistantModel.Message.Length > 2000)
        {
            assistantError = "ProductCare questions cannot exceed 2000 characters.";
            return;
        }

        await AskAssistant();
    }

    private async Task AskAssistant()
    {
        if (product is null || AssistantQuotaExhausted || isAskingAssistant || string.IsNullOrWhiteSpace(assistantModel.Message))
        {
            return;
        }

        string message = assistantModel.Message.Trim();

        if (message.Length > 2000)
        {
            assistantError = "ProductCare questions cannot exceed 2000 characters.";
            return;
        }

        isAskingAssistant = true;
        streamingAssistantAnswer = string.Empty;
        assistantError = null;
        conversationNotice = null;

        assistantMessages.Add(new AssistantChatMessage(false, message, null));

        RequestChatScroll(true);

        await InvokeAsync(StateHasChanged);

        try
        {
            ProductAssistantResponse result = await ApiClient.StreamProductAssistantAsync(
                product.Id,
                message,
                async delta =>
                {
                    streamingAssistantAnswer += delta;

                    RequestChatScroll(false);

                    await InvokeAsync(StateHasChanged);
                });

            assistantMessages.Add(new AssistantChatMessage(true, result.Answer, result));
            assistantModel.Message = string.Empty;
            streamingAssistantAnswer = null;
        }
        catch (ProductCareQuotaExceededException exception)
        {
            streamingAssistantAnswer = null;
            assistantError = BuildQuotaMessage("ProductCare Assistant", exception);
        }
        catch
        {
            streamingAssistantAnswer = null;
            assistantError = "ProductCare Assistant could not complete the request.";
        }
        finally
        {
            await RefreshUsageSafelyAsync();

            isAskingAssistant = false;

            RequestChatScroll(true);
            focusAssistantAfterRender = true;

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartNewConversation()
    {
        if (product is null || isAskingAssistant)
        {
            return;
        }

        isStartingNewConversation = true;
        assistantError = null;
        conversationNotice = null;

        try
        {
            await ApiClient.StartNewProductAssistantConversationAsync(product.Id);

            assistantMessages.Clear();
            assistantModel = new AssistantQuestionModel();
            streamingAssistantAnswer = null;
            conversationNotice = "New conversation started. Previous conversation context was cleared.";
        }
        catch
        {
            assistantError = "ProductCare could not start a new conversation.";
        }
        finally
        {
            isStartingNewConversation = false;
            focusAssistantAfterRender = true;

            await InvokeAsync(StateHasChanged);
        }
    }

    private void RequestChatScroll(bool smooth)
    {
        scrollChatAfterRender = true;
        smoothChatScrollAfterRender = smooth;
    }

    private async Task ScrollAssistantChatAsync(bool smooth)
    {
        try
        {
            await JS.InvokeVoidAsync("productCareUi.scrollChatToBottom", assistantChat, smooth);
        }
        catch
        {
            // Scrolling is a UI enhancement and should not affect assistant functionality.
        }
    }

    private async Task FocusAssistantTextAreaAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("productCareUi.focusWithoutScroll", assistantTextArea);
        }
        catch
        {
            // Restoring keyboard focus should not affect assistant functionality.
        }
    }

    private async Task CheckSafety()
    {
        if (product is null)
        {
            return;
        }

        isCheckingSafety = true;
        safetyResult = null;
        safetyError = null;

        try
        {
            safetyResult = await ApiClient.GetProductSafetyAsync(product.Id);
        }
        catch
        {
            safetyError = "ProductCare could not check the CPSC recall database.";
        }
        finally
        {
            isCheckingSafety = false;
        }
    }

    private async Task RefreshUsageSafelyAsync()
    {
        try
        {
            await UsageState.RefreshAsync();
        }
        catch
        {
            // The completed AI response remains valid even if the usage indicator cannot be refreshed.
        }
    }

    private static string BuildQuotaMessage(string featureName, ProductCareQuotaExceededException exception)
    {
        if (exception.RetryAfterUtc.HasValue)
        {
            return $"{featureName} has reached its daily limit. It resets at {exception.RetryAfterUtc.Value.ToLocalTime():g} local time.";
        }

        return $"{featureName} has reached its daily limit. Please try again after the daily UTC reset.";
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private void OnUsageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UsageState.Changed -= OnUsageChanged;
    }

    private sealed record AssistantChatMessage(bool IsAssistant, string Text, ProductAssistantResponse? Result);

    private sealed class AssistantQuestionModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(2000, MinimumLength = 1)]
        public string Message { get; set; } = string.Empty;
    }
}