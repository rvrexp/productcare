@page "/products/{Id:guid}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ProductCare.Web.Api
@using ProductCare.Web.Usage
@implements IDisposable

@attribute [Authorize]

@inject ProductCareApiClient ApiClient
@inject UsageQuotaState UsageState

<PageTitle>Product Details | ProductCare AI</PageTitle>

<h3>Product Details</h3>

@if (isLoading)
{
    <p>Loading product...</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
else if (product is not null)
{
    <dl>
        <dt>Product</dt>
        <dd>@Display(product.ProductName)</dd>

        <dt>Manufacturer</dt>
        <dd>@Display(product.Manufacturer)</dd>

        <dt>Model Number</dt>
        <dd>@Display(product.ModelNumber)</dd>

        <dt>Serial Number</dt>
        <dd>@Display(product.SerialNumber)</dd>
    </dl>

    <hr />

    <h4>ProductCare Assistant</h4>

    <p>
        Ask naturally about this product. ProductCare can search the product manual
        and check official recall information when needed.
    </p>

    @if (UsageState.IsLoaded)
    {
        <p class="small @(AssistantQuotaExhausted ? "text-danger fw-semibold" : "text-muted")">
            @UsageState.GetRemainingText(UsageQuotaState.ProductAssistantOperation)
        </p>
    }

    @if (AssistantQuotaExhausted)
    {
        <div class="alert alert-warning">
            The daily ProductCare Assistant limit has been reached.
            @ResetMessage
        </div>
    }

    <EditForm Model="@assistantModel" OnValidSubmit="AskAssistant">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Ask ProductCare</label>

            <InputTextArea class="form-control"
                           @bind-Value="assistantModel.Message"
                           rows="3"
                           placeholder="For example: How do I get this thing connected to Wi-Fi?"
                           disabled="@AssistantQuotaExhausted" />

            <ValidationMessage For="@(() => assistantModel.Message)" />
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@(isAskingAssistant || AssistantQuotaExhausted)">
            @(isAskingAssistant ? "Thinking..." : "Ask ProductCare")
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(assistantError))
    {
        <div class="alert alert-danger mt-3">
            @assistantError
        </div>
    }

    @if (assistantResult is not null)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">ProductCare</h5>

                <p>@assistantResult.Answer</p>

                @if (assistantResult.Sources.Count > 0)
                {
                    <h6>Sources</h6>

                    <ul>
                        @foreach (ProductAssistantSourceResponse source in assistantResult.Sources)
                        {
                            <li>
                                @if (!string.IsNullOrWhiteSpace(source.Url))
                                {
                                    <a href="@source.Url"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        @source.Title
                                    </a>
                                }
                                else
                                {
                                    @source.Title
                                }
                            </li>
                        }
                    </ul>
                }

                @if (assistantResult.ToolsUsed.Count > 0)
                {
                    <small class="text-muted">
                        Capabilities used: @string.Join(", ", assistantResult.ToolsUsed)
                    </small>
                }
            </div>
        </div>
    }

    <hr />

    <h4>Ask About This Product</h4>

    <p>Ask a question using the available product manual as the grounded source.</p>

    @if (UsageState.IsLoaded)
    {
        <p class="small @(KnowledgeQuotaExhausted ? "text-danger fw-semibold" : "text-muted")">
            @UsageState.GetRemainingText(UsageQuotaState.ProductKnowledgeOperation)
        </p>
    }

    @if (KnowledgeQuotaExhausted)
    {
        <div class="alert alert-warning">
            The daily product manual question limit has been reached.
            @ResetMessage
        </div>
    }

    @if (string.IsNullOrWhiteSpace(product.Manufacturer) || string.IsNullOrWhiteSpace(product.ModelNumber))
    {
        <div class="alert alert-warning">
            ProductCare needs a confirmed manufacturer and model number before it can search the product manual.
        </div>
    }
    else
    {
        <EditForm Model="@questionModel" OnValidSubmit="AskQuestion">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Question</label>

                <InputTextArea class="form-control"
                               @bind-Value="questionModel.Question"
                               rows="3"
                               disabled="@KnowledgeQuotaExhausted" />

                <ValidationMessage For="@(() => questionModel.Question)" />
            </div>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@(isAsking || KnowledgeQuotaExhausted)">
                @(isAsking ? "Searching manual..." : "Ask")
            </button>
        </EditForm>
    }

    @if (!string.IsNullOrWhiteSpace(questionError))
    {
        <div class="alert alert-danger mt-3">
            @questionError
        </div>
    }

    @if (answer is not null)
    {
        <div class="mt-4">
            <h5>Answer</h5>

            <p>@answer.Answer</p>

            @if (answer.Citations.Count > 0)
            {
                <h6>Sources</h6>

                <ul>
                    @foreach (ProductKnowledgeCitationResponse citation in answer.Citations)
                    {
                        <li>@citation.SourceId — @citation.Title</li>
                    }
                </ul>
            }
        </div>
    }

    <hr />

    <h4>Safety & Recalls</h4>

    <p>
        Check this product model against the U.S. Consumer Product Safety Commission recall database.
    </p>

    <p class="small text-muted">
        Recall lookup does not use your daily AI quota.
    </p>

    @if (string.IsNullOrWhiteSpace(product.Manufacturer) || string.IsNullOrWhiteSpace(product.ModelNumber))
    {
        <div class="alert alert-warning">
            A confirmed manufacturer and model number are required before ProductCare can perform a reliable recall check.
        </div>
    }
    else
    {
        <button class="btn btn-outline-danger"
                @onclick="CheckSafety"
                disabled="@isCheckingSafety">
            @(isCheckingSafety ? "Checking recalls..." : "Check Recalls")
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(safetyError))
    {
        <div class="alert alert-danger mt-3">
            @safetyError
        </div>
    }

    @if (safetyResult is not null)
    {
        <div class="mt-3">

            @if (safetyResult.Recalls.Count == 0)
            {
                <div class="alert alert-success">
                    No matching CPSC recall was found for this model in the current lookup.
                    This does not guarantee that the product is free of safety issues.
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <strong>A matching CPSC recall was found.</strong>
                </div>

                @foreach (ProductRecallResponse recall in safetyResult.Recalls)
                {
                    <div class="card mb-3">
                        <div class="card-body">

                            <h5 class="card-title">@recall.Title</h5>

                            <p>
                                <strong>Recall number:</strong>
                                @recall.RecallNumber
                            </p>

                            @if (recall.RecallDate.HasValue)
                            {
                                <p>
                                    <strong>Recall date:</strong>
                                    @recall.RecallDate.Value.ToString("MMMM d, yyyy")
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.Hazard))
                            {
                                <p>
                                    <strong>Hazard:</strong>
                                    @recall.Hazard
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.Remedy))
                            {
                                <p>
                                    <strong>Remedy:</strong>
                                    @recall.Remedy
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.ConsumerContact))
                            {
                                <p>
                                    <strong>Consumer contact:</strong>
                                    @recall.ConsumerContact
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.OfficialUrl))
                            {
                                <a href="@recall.OfficialUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    View official CPSC recall
                                </a>
                            }
                        </div>
                    </div>
                }
            }

            <small class="text-muted">
                Checked @safetyResult.CheckedUtc.ToLocalTime().ToString("g")
            </small>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProductResponse? product;

    private ProductKnowledgeResponse? answer;
    private QuestionModel questionModel = new();
    private bool isAsking;
    private string? questionError;

    private ProductSafetyResponse? safetyResult;
    private bool isCheckingSafety;
    private string? safetyError;

    private ProductAssistantResponse? assistantResult;
    private AssistantQuestionModel assistantModel = new();
    private bool isAskingAssistant;
    private string? assistantError;

    private bool isLoading = true;
    private string? loadError;

    private bool KnowledgeQuotaExhausted =>
        UsageState.IsExhausted(UsageQuotaState.ProductKnowledgeOperation);

    private bool AssistantQuotaExhausted =>
        UsageState.IsExhausted(UsageQuotaState.ProductAssistantOperation);

    private string ResetMessage =>
        UsageState.Summary is null
            ? "The quota will be available again after the daily UTC reset."
            : $"The quota resets at {UsageState.Summary.ResetUtc.ToLocalTime():g} local time.";

    protected override async Task OnInitializedAsync()
    {
        UsageState.Changed += OnUsageChanged;

        try
        {
            product = await ApiClient.GetProductAsync(Id);

            if (product is null)
            {
                loadError = "Product could not be found.";
                return;
            }

            try
            {
                await UsageState.EnsureLoadedAsync();
            }
            catch
            {
                // Product details can still be used if the usage indicator temporarily fails.
            }
        }
        catch
        {
            loadError = "Product could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AskQuestion()
    {
        if (product is null || KnowledgeQuotaExhausted)
        {
            return;
        }

        isAsking = true;
        answer = null;
        questionError = null;

        try
        {
            answer = await ApiClient.AskProductQuestionAsync(
                product.Id,
                questionModel.Question);
        }
        catch (ProductCareQuotaExceededException exception)
        {
            questionError = BuildQuotaMessage(
                "Product manual questions",
                exception);
        }
        catch
        {
            questionError =
                "ProductCare could not search the product documentation.";
        }
        finally
        {
            await RefreshUsageSafelyAsync();
            isAsking = false;
        }
    }

    private async Task AskAssistant()
    {
        if (product is null || AssistantQuotaExhausted)
        {
            return;
        }

        isAskingAssistant = true;
        assistantResult = null;
        assistantError = null;

        try
        {
            assistantResult = await ApiClient.AskProductAssistantAsync(
                product.Id,
                assistantModel.Message);
        }
        catch (ProductCareQuotaExceededException exception)
        {
            assistantError = BuildQuotaMessage(
                "ProductCare Assistant",
                exception);
        }
        catch
        {
            assistantError =
                "ProductCare Assistant could not complete the request.";
        }
        finally
        {
            await RefreshUsageSafelyAsync();
            isAskingAssistant = false;
        }
    }

    private async Task CheckSafety()
    {
        if (product is null)
        {
            return;
        }

        isCheckingSafety = true;
        safetyResult = null;
        safetyError = null;

        try
        {
            safetyResult = await ApiClient.GetProductSafetyAsync(product.Id);
        }
        catch
        {
            safetyError =
                "ProductCare could not check the CPSC recall database.";
        }
        finally
        {
            isCheckingSafety = false;
        }
    }

    private async Task RefreshUsageSafelyAsync()
    {
        try
        {
            await UsageState.RefreshAsync();
        }
        catch
        {
            // The completed AI response remains valid even if usage refresh fails.
        }
    }

    private static string BuildQuotaMessage(
        string featureName,
        ProductCareQuotaExceededException exception)
    {
        if (exception.RetryAfterUtc.HasValue)
        {
            return $"{featureName} has reached its daily limit. It resets at {exception.RetryAfterUtc.Value.ToLocalTime():g} local time.";
        }

        return $"{featureName} has reached its daily limit. Please try again after the daily UTC reset.";
    }

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private void OnUsageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UsageState.Changed -= OnUsageChanged;
    }

    private sealed class QuestionModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(
            1000,
            MinimumLength = 3)]
        public string Question { get; set; } = string.Empty;
    }

    private sealed class AssistantQuestionModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(
            2000,
            MinimumLength = 1)]
        public string Message { get; set; } = string.Empty;
    }
}