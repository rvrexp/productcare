@page "/products/{Id:guid}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ProductCare.Web.Api

@attribute [Authorize]

@inject ProductCareApiClient ApiClient

@* Displays the selected product together with manual Q&A, assistant, and recall workflows. *@
<h3>Product Details</h3>

@if (isLoading)
{
    <p>Loading product...</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
else if (product is not null)
{
    <dl>
        <dt>Product</dt>
        <dd>@Display(product.ProductName)</dd>

        <dt>Manufacturer</dt>
        <dd>@Display(product.Manufacturer)</dd>

        <dt>Model Number</dt>
        <dd>@Display(product.ModelNumber)</dd>

        <dt>Serial Number</dt>
        <dd>@Display(product.SerialNumber)</dd>
    </dl>

    <hr />

    <h4>Ask About This Product</h4>


    <hr />

    @* Conversational assistant that can combine manual answers and recall checks in one request. *@
    <h4>ProductCare Assistant</h4>

    <p>Ask naturally about this product. ProductCare can search the product manual and check official recall information when needed.</p>

    <EditForm Model="@assistantModel" OnValidSubmit="AskAssistant">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Ask ProductCare</label>
            <InputTextArea class="form-control" @bind-Value="assistantModel.Message" rows="3" placeholder="For example: How do I get this thing connected to Wi-Fi?" />
            <ValidationMessage For="@(() => assistantModel.Message)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isAskingAssistant">@(isAskingAssistant ? "Thinking..." : "Ask ProductCare")</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(assistantError))
    {
        <div class="alert alert-danger mt-3">@assistantError</div>
    }

    @if (assistantResult is not null)
    {
        @* Shows the assistant answer together with the sources and capabilities used to produce it. *@
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">ProductCare</h5>

                <p>@assistantResult.Answer</p>

                @if (assistantResult.Sources.Count > 0)
                {
                    <h6>Sources</h6>

                    <ul>
                        @foreach (ProductAssistantSourceResponse source in assistantResult.Sources)
                        {
                            <li>
                                @if (!string.IsNullOrWhiteSpace(source.Url))
                                {
                                    <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a>
                                }
                                else
                                {
                                    @source.Title
                                }
                            </li>
                        }
                    </ul>
                }

                @if (assistantResult.ToolsUsed.Count > 0)
                {
                    <small class="text-muted">Capabilities used: @string.Join(", ", assistantResult.ToolsUsed)</small>
                }
            </div>
        </div>
    }








    @* Manual question workflow for grounded answers from product documentation. *@
    @if (string.IsNullOrWhiteSpace(product.Manufacturer) || string.IsNullOrWhiteSpace(product.ModelNumber))
    {
        <div class="alert alert-warning">ProductCare needs a confirmed manufacturer and model number before it can search the product manual.</div>
    }
    else
    {
        <EditForm Model="@questionModel" OnValidSubmit="AskQuestion">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Question</label>
                <InputTextArea class="form-control" @bind-Value="questionModel.Question" rows="3" />
                <ValidationMessage For="@(() => questionModel.Question)" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@isAsking">@(isAsking ? "Searching manual..." : "Ask")</button>
        </EditForm>
    }

    @if (!string.IsNullOrWhiteSpace(questionError))
    {
        <div class="alert alert-danger mt-3">@questionError</div>
    }

    @if (answer is not null)
    {
        <div class="mt-4">
            <h5>Answer</h5>
            <p>@answer.Answer</p>

            @if (answer.Citations.Count > 0)
            {
                <h6>Sources</h6>

                <ul>
                    @foreach (ProductKnowledgeCitationResponse citation in answer.Citations)
                    {
                        <li>@citation.SourceId — @citation.Title</li>
                    }
                </ul>
            }
        </div>
    }

    <hr />

    @* Recall lookup section backed by official CPSC data. *@
    <h4>Safety & Recalls</h4>

    <p>Check this product model against the U.S. Consumer Product Safety Commission recall database.</p>

    @if (string.IsNullOrWhiteSpace(product.Manufacturer) || string.IsNullOrWhiteSpace(product.ModelNumber))
    {
        <div class="alert alert-warning">
            A confirmed manufacturer and model number are required before ProductCare can perform a reliable recall check.
        </div>
    }
    else
    {
        <button class="btn btn-outline-danger" @onclick="CheckSafety" disabled="@isCheckingSafety">
            @(isCheckingSafety ? "Checking recalls..." : "Check Recalls")
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(safetyError))
    {
        <div class="alert alert-danger mt-3">@safetyError</div>
    }

    @if (safetyResult is not null)
    {
        <div class="mt-3">
            @if (safetyResult.Recalls.Count == 0)
            {
                <div class="alert alert-success">
                    No matching CPSC recall was found for this model in the current lookup. This does not guarantee that the product is free of safety issues.
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <strong>A matching CPSC recall was found.</strong>
                </div>

                @foreach (ProductRecallResponse recall in safetyResult.Recalls)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">@recall.Title</h5>

                            <p><strong>Recall number:</strong> @recall.RecallNumber</p>

                            @if (recall.RecallDate.HasValue)
                            {
                                <p><strong>Recall date:</strong> @recall.RecallDate.Value.ToString("MMMM d, yyyy")</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.Hazard))
                            {
                                <p><strong>Hazard:</strong> @recall.Hazard</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.Remedy))
                            {
                                <p><strong>Remedy:</strong> @recall.Remedy</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.ConsumerContact))
                            {
                                <p><strong>Consumer contact:</strong> @recall.ConsumerContact</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(recall.OfficialUrl))
                            {
                                <a href="@recall.OfficialUrl" target="_blank" rel="noopener noreferrer">View official CPSC recall</a>
                            }
                        </div>
                    </div>
                }
            }

            <small class="text-muted">Checked @safetyResult.CheckedUtc.ToLocalTime().ToString("g")</small>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProductResponse? product;
    private ProductKnowledgeResponse? answer;
    private QuestionModel questionModel = new();
    private bool isLoading = true;
    private bool isAsking;
    private string? loadError;
    private string? questionError;

    private ProductSafetyResponse? safetyResult;
    private bool isCheckingSafety;
    private string? safetyError;

    private ProductAssistantResponse? assistantResult;
    private AssistantQuestionModel assistantModel = new();
    private bool isAskingAssistant;
    private string? assistantError;

    // Loads the product once when the page is initialized so the page can drive all downstream workflows.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            product = await ApiClient.GetProductAsync(Id);

            if (product is null)
            {
                loadError = "Product could not be found.";
            }
        }
        catch
        {
            loadError = "Product could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Sends the user's manual question to the API and updates the page with the grounded answer.
    private async Task AskQuestion()
    {
        if (product is null)
        {
            return;
        }

        isAsking = true;
        answer = null;
        questionError = null;

        try
        {
            answer = await ApiClient.AskProductQuestionAsync(product.Id, questionModel.Question);
        }
        catch
        {
            questionError = "ProductCare could not search the product documentation.";
        }
        finally
        {
            isAsking = false;
        }
    }

    // Normalizes empty product fields for display in the definition list.
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    // Form model used by the manual question experience.
    private sealed class QuestionModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(1000, MinimumLength = 3)]
        public string Question { get; set; } = string.Empty;
    }

    // Requests the current recall status for the loaded product and refreshes the safety panel.
    private async Task CheckSafety()
    {
        if (product is null)
        {
            return;
        }

        isCheckingSafety = true;
        safetyResult = null;
        safetyError = null;

        try
        {
            safetyResult = await ApiClient.GetProductSafetyAsync(product.Id);
        }
        catch
        {
            safetyError = "ProductCare could not check the CPSC recall database.";
        }
        finally
        {
            isCheckingSafety = false;
        }
    }

    // Sends the assistant prompt to the API and refreshes the conversational result panel.
    private async Task AskAssistant()
    {
        if (product is null)
        {
            return;
        }

        isAskingAssistant = true;
        assistantResult = null;
        assistantError = null;

        try
        {
            assistantResult = await ApiClient.AskProductAssistantAsync(product.Id, assistantModel.Message);
        }
        catch
        {
            assistantError = "ProductCare Assistant could not complete the request.";
        }
        finally
        {
            isAskingAssistant = false;
        }
    }

    // Form model used by the conversational product assistant.
    private sealed class AssistantQuestionModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(2000, MinimumLength = 1)]
        public string Message { get; set; } = string.Empty;
    }
}