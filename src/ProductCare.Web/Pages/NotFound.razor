@page "/not-found"

@layout MainLayout

<PageTitle>Not Found | ProductCare AI</PageTitle>

<section class="pc-panel">
    <div class="pc-empty-state">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3"
             style="width: 56px; height: 56px;">
            <i class="bi bi-compass fs-3" aria-hidden="true"></i>
        </div>

        <div class="pc-eyebrow">404 · Page not found</div>

        <h1 class="h3 mb-2">
            We couldn't find that page
        </h1>

        <p class="mb-4">
            The page you requested does not exist, may have moved, or may no longer be available.
        </p>

        <div class="pc-actions justify-content-center">
            <a class="btn btn-primary pc-primary-button" href="/">
                <i class="bi bi-house-door me-1" aria-hidden="true"></i>
                Go to Home
            </a>

            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-outline-secondary" href="/products">
                        <i class="bi bi-boxes me-1" aria-hidden="true"></i>
                        My Products
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</section>