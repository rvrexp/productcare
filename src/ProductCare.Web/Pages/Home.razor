@page "/"

@using ProductCare.Web.Access
@implements IDisposable

@inject UserAccessState AccessState

<PageTitle>ProductCare AI</PageTitle>

<section class="pc-hero">
    <div class="pc-eyebrow">ProductCare AI</div>

    <h1>Understand, manage, and support the products you own.</h1>

    <p class="pc-hero-copy">
        Identify products from images, keep track of your products, search trusted product documentation, and check official product recall information.
    </p>

    <AuthorizeView>
        <Authorized>
            @if (!AccessState.IsLoaded)
            {
                <div class="pc-actions">
                    <span class="text-muted">Checking ProductCare access...</span>
                </div>
            }
            else if (AccessState.IsActive)
            {
                <div class="pc-actions">
                    <a class="btn btn-primary pc-primary-button" href="identify">Identify a product</a>
                    <a class="btn btn-outline-secondary" href="products">View my products</a>
                </div>
            }
            else
            {
                <div class="pc-actions">
                    <a class="btn btn-primary pc-primary-button" href="access">
                        @(AccessState.IsPending ? "View access status" : "Request access")
                    </a>
                </div>
            }
        </Authorized>

        <NotAuthorized>
            <div class="pc-actions">
                <a class="btn btn-primary pc-primary-button" href="authentication/login">Sign in to ProductCare</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</section>

<section class="pc-feature-grid">
    <article class="pc-feature-card">
        <div class="pc-eyebrow">AI Vision</div>
        <h2>Identify a product</h2>
        <p>Upload a product image and use AI-assisted identification to determine its manufacturer, model, and product information.</p>

        <AuthorizeView>
            <Authorized>
                @if (AccessState.IsActive)
                {
                    <a href="identify">Identify product →</a>
                }
            </Authorized>
        </AuthorizeView>
    </article>

    <article class="pc-feature-card">
        <div class="pc-eyebrow">Product Support</div>
        <h2>Ask about your products</h2>
        <p>Search trusted product documentation and ask ProductCare questions about products saved to your account.</p>

        <AuthorizeView>
            <Authorized>
                @if (AccessState.IsActive)
                {
                    <a href="products">View my products →</a>
                }
            </Authorized>
        </AuthorizeView>
    </article>

    <article class="pc-feature-card">
        <div class="pc-eyebrow">Safety</div>
        <h2>Check product recalls</h2>
        <p>Check saved products against official U.S. Consumer Product Safety Commission recall information.</p>

        <AuthorizeView>
            <Authorized>
                @if (AccessState.IsActive)
                {
                    <a href="products">Check my products →</a>
                }
            </Authorized>
        </AuthorizeView>
    </article>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        AccessState.Changed += OnAccessChanged;

        try
        {
            await AccessState.EnsureLoadedAsync();
        }
        catch
        {
            // The Access page provides the detailed error and retry experience.
        }
    }

    private void OnAccessChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AccessState.Changed -= OnAccessChanged;
    }
}