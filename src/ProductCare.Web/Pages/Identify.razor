@page "/identify"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ProductCare.Web.Api
@using ProductCare.Web.Usage
@implements IDisposable

@attribute [Authorize]

@inject ProductCareApiClient ApiClient
@inject UsageQuotaState UsageState

<PageTitle>Identify Product | ProductCare AI</PageTitle>

<div class="pc-page-header">
    <div>
        <div class="pc-eyebrow">AI Vision</div>
        <h1>Identify a product</h1>
        <p>Upload a clear image showing the product, label, manufacturer, or model information.</p>
    </div>
</div>

<section class="pc-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Product image</h2>

        @if (UsageState.IsLoaded)
        {
            <span class="small @(IdentificationQuotaExhausted ? "text-danger fw-semibold" : "text-muted")">
                @UsageState.GetRemainingText(UsageQuotaState.ProductIdentificationOperation)
            </span>
        }
    </div>

    @if (IdentificationQuotaExhausted)
    {
        <div class="alert alert-warning">
            The daily product identification limit has been reached.
            @ResetMessage
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Product image</label>

        <InputFile OnChange="SelectImage"
                   accept="image/jpeg,image/png,image/webp"
                   class="form-control"
                   disabled="@IdentificationQuotaExhausted" />

        <div class="form-text">
            JPEG, PNG, or WebP. Maximum file size: 5 MB.
        </div>
    </div>

    @if (selectedFile is not null)
    {
        <p class="text-muted">
            Selected: @selectedFile.Name
        </p>
    }

    <button type="button"
            class="btn btn-primary"
            @onclick="IdentifyProduct"
            disabled="@(selectedFile is null || isIdentifying || IdentificationQuotaExhausted)">
        @(isIdentifying ? "Identifying..." : "Identify Product")
    </button>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }
</section>

@if (result is not null)
{
    <section class="pc-panel mt-4">
        <div class="pc-eyebrow">Identification Result</div>
        <h2 class="h4">Product details</h2>

        <dl>
            <dt>Manufacturer</dt>
            <dd>@Display(result.Manufacturer)</dd>

            <dt>Model number</dt>
            <dd>@Display(result.ModelNumber)</dd>

            <dt>Product type</dt>
            <dd>@Display(result.ProductType)</dd>

            <dt>Product name</dt>
            <dd>@Display(result.ProductName)</dd>

            <dt>Confidence</dt>
            <dd>@result.Confidence</dd>
        </dl>

        @if (result.ObservedText.Count > 0)
        {
            <h3 class="h6">Observed text</h3>

            <ul>
                @foreach (string text in result.ObservedText)
                {
                    <li>@text</li>
                }
            </ul>
        }
    </section>
}

@code {
    private IBrowserFile? selectedFile;
    private ProductIdentificationResponse? result;
    private bool isIdentifying;
    private string? errorMessage;

    private bool IdentificationQuotaExhausted =>
        UsageState.IsExhausted(UsageQuotaState.ProductIdentificationOperation);

    private string ResetMessage =>
        UsageState.Summary is null
            ? "The quota will be available again after the daily UTC reset."
            : $"The quota resets at {UsageState.Summary.ResetUtc.ToLocalTime():g} local time.";

    protected override async Task OnInitializedAsync()
    {
        UsageState.Changed += OnUsageChanged;

        try
        {
            await UsageState.EnsureLoadedAsync();
        }
        catch
        {
            // Failure to load the usage indicator should not prevent the page itself from loading.
        }
    }

    private void SelectImage(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        result = null;
        errorMessage = null;
    }

    private async Task IdentifyProduct()
    {
        if (selectedFile is null || IdentificationQuotaExhausted)
        {
            return;
        }

        isIdentifying = true;
        result = null;
        errorMessage = null;

        try
        {
            result = await ApiClient.IdentifyProductAsync(selectedFile);
        }
        catch (ProductCareQuotaExceededException exception)
        {
            errorMessage = BuildQuotaMessage("Product identification", exception);
        }
        catch
        {
            errorMessage = "ProductCare could not identify the product. Please try again.";
        }
        finally
        {
            await RefreshUsageSafelyAsync();
            isIdentifying = false;
        }
    }

    private async Task RefreshUsageSafelyAsync()
    {
        try
        {
            await UsageState.RefreshAsync();
        }
        catch
        {
            // The AI result remains valid even if the usage indicator cannot be refreshed.
        }
    }

    private static string BuildQuotaMessage(string featureName, ProductCareQuotaExceededException exception)
    {
        if (exception.RetryAfterUtc.HasValue)
        {
            return $"{featureName} has reached its daily limit. It resets at {exception.RetryAfterUtc.Value.ToLocalTime():g} local time.";
        }

        return $"{featureName} has reached its daily limit. Please try again after the daily UTC reset.";
    }

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private void OnUsageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UsageState.Changed -= OnUsageChanged;
    }
}