@page "/identify"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ProductCare.Web.Api
@using ProductCare.Web.Usage
@implements IDisposable

@attribute [Authorize]

@inject ProductCareApiClient ApiClient
@inject UsageQuotaState UsageState

<PageTitle>Identify Product | ProductCare AI</PageTitle>

<div class="pc-page-header pc-page-header-with-action">
    <div>
        <div class="pc-eyebrow">AI Vision</div>
        <h1>Identify a product</h1>
        <p>Upload a clear image showing the product, label, manufacturer, or model information.</p>
    </div>

    <a class="btn btn-outline-secondary" href="products">View my products</a>
</div>

<section class="pc-panel">
    <div class="pc-section-header">
        <div>
            <div class="pc-eyebrow">Product image</div>
            <h2>Upload an image</h2>
            <p>Clear labels, logos, model numbers, and product markings improve identification accuracy.</p>
        </div>

        @if (UsageState.IsLoaded)
        {
            <div class="pc-quota-badge @(IdentificationQuotaExhausted ? "pc-quota-badge-exhausted" : "")">
                @UsageState.GetRemainingText(UsageQuotaState.ProductIdentificationOperation)
            </div>
        }
    </div>

    @if (IdentificationQuotaExhausted)
    {
        <div class="alert alert-warning">
            <strong>Daily identification limit reached.</strong>
            @ResetMessage
        </div>
    }

    <div class="pc-upload-area">
        <div class="pc-upload-content">
            <div class="pc-upload-title">Choose a product image</div>

            <p>
                Select a JPEG, PNG, or WebP image up to 5 MB.
            </p>

            <InputFile OnChange="SelectImage"
                       accept="image/jpeg,image/png,image/webp"
                       class="form-control pc-upload-control"
                       disabled="@IdentificationQuotaExhausted" />
        </div>
    </div>

    @if (selectedFile is not null)
    {
        <div class="pc-selected-file">
            <div>
                <span class="pc-meta-label">Selected image</span>
                <strong>@selectedFile.Name</strong>
            </div>

            <span>@FormatFileSize(selectedFile.Size)</span>
        </div>
    }

    <div class="pc-identify-actions">
        <button type="button"
                class="btn btn-primary pc-primary-button"
                @onclick="IdentifyProduct"
                disabled="@(selectedFile is null || isIdentifying || IdentificationQuotaExhausted)">
            @(isIdentifying ? "Identifying..." : "Identify product")
        </button>

        @if (isIdentifying)
        {
            <span class="pc-inline-status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                Analyzing the product image...
            </span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="pc-error pc-section-message">
            @errorMessage
        </div>
    }
</section>

@if (result is not null)
{
    <section class="pc-panel">
        <div class="pc-section-header">
            <div>
                <div class="pc-eyebrow">Identification result</div>
                <h2>Product details</h2>
                <p>Review the information detected from the uploaded image.</p>
            </div>

            <span class="pc-confidence-badge">
                @result.Confidence confidence
            </span>
        </div>

        <div class="pc-identification-grid">
            <div class="pc-result-item">
                <span class="pc-meta-label">Product</span>
                <span class="pc-meta-value">@Display(result.ProductName)</span>
            </div>

            <div class="pc-result-item">
                <span class="pc-meta-label">Manufacturer</span>
                <span class="pc-meta-value">@Display(result.Manufacturer)</span>
            </div>

            <div class="pc-result-item">
                <span class="pc-meta-label">Model number</span>
                <span class="pc-meta-value">@Display(result.ModelNumber)</span>
            </div>

            <div class="pc-result-item">
                <span class="pc-meta-label">Product type</span>
                <span class="pc-meta-value">@Display(result.ProductType)</span>
            </div>
        </div>

        @if (result.ObservedText.Count > 0)
        {
            <div class="pc-observed-text-section">
                <div class="pc-meta-label">Text observed in the image</div>

                <div class="pc-observed-text-list">
                    @foreach (string text in result.ObservedText)
                    {
                        <span class="pc-observed-text-item">@text</span>
                    }
                </div>
            </div>
        }
    </section>
}

@code {
    private IBrowserFile? selectedFile;
    private ProductIdentificationResponse? result;
    private bool isIdentifying;
    private string? errorMessage;

    private bool IdentificationQuotaExhausted => UsageState.IsExhausted(UsageQuotaState.ProductIdentificationOperation);

    private string ResetMessage => UsageState.Summary is null ? "The quota will be available again after the daily UTC reset." : $"The quota resets at {UsageState.Summary.ResetUtc.ToLocalTime():g} local time.";

    protected override async Task OnInitializedAsync()
    {
        UsageState.Changed += OnUsageChanged;

        try
        {
            await UsageState.EnsureLoadedAsync();
        }
        catch
        {
            // Failure to load the usage indicator should not prevent the page itself from loading.
        }
    }

    private void SelectImage(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        result = null;
        errorMessage = null;
    }

    private async Task IdentifyProduct()
    {
        if (selectedFile is null || IdentificationQuotaExhausted)
        {
            return;
        }

        isIdentifying = true;
        result = null;
        errorMessage = null;

        try
        {
            result = await ApiClient.IdentifyProductAsync(selectedFile);
        }
        catch (ProductCareQuotaExceededException exception)
        {
            errorMessage = BuildQuotaMessage("Product identification", exception);
        }
        catch
        {
            errorMessage = "ProductCare could not identify the product. Please try again.";
        }
        finally
        {
            await RefreshUsageSafelyAsync();
            isIdentifying = false;
        }
    }

    private async Task RefreshUsageSafelyAsync()
    {
        try
        {
            await UsageState.RefreshAsync();
        }
        catch
        {
            // The AI result remains valid even if the usage indicator cannot be refreshed.
        }
    }

    private static string BuildQuotaMessage(string featureName, ProductCareQuotaExceededException exception)
    {
        if (exception.RetryAfterUtc.HasValue)
        {
            return $"{featureName} has reached its daily limit. It resets at {exception.RetryAfterUtc.Value.ToLocalTime():g} local time.";
        }

        return $"{featureName} has reached its daily limit. Please try again after the daily UTC reset.";
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatFileSize(long bytes)
    {
        double megabytes = bytes / 1024d / 1024d;
        return $"{megabytes:0.##} MB";
    }

    private void OnUsageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UsageState.Changed -= OnUsageChanged;
    }
}