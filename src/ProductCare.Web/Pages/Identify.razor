@page "/identify"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using ProductCare.Web.Api

@attribute [Authorize]

@inject ProductCareApiClient ApiClient

<PageTitle>Identify Product | ProductCare AI</PageTitle>

<div class="pc-page-header">
    <h1>Identify Product</h1>
    <p>Upload a clear photo of the product or its label and ProductCare AI will attempt to identify it.</p>
</div>

<section class="pc-panel">
    <div class="pc-upload-area">
        <h2 class="h5 mb-2">Upload a product image</h2>
        <p class="text-muted mb-3">For the best result, make sure the manufacturer name, model number, or product label is clearly visible.</p>

        <InputFile OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" aria-label="Select a product image" />

        @if (selectedFile is not null)
        {
            <div class="mt-3">
                <strong>Selected file:</strong>
                <span>@selectedFile.Name</span>
            </div>
        }
    </div>

    <div class="pc-actions mt-3">
        <button type="button" class="btn btn-primary pc-primary-button" @onclick="IdentifyProduct" disabled="@(selectedFile is null || isIdentifying)">
            @(isIdentifying ? "Identifying..." : "Identify Product")
        </button>
    </div>

    @if (isIdentifying)
    {
        <div class="pc-loading mt-3" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Identifying product...</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="pc-error mt-3" role="alert">
            @errorMessage
        </div>
    }
</section>

@if (result is not null)
{
    <section class="pc-panel mt-4">
        <div class="pc-page-header">
            <h2 class="h4">Review Product</h2>
            <p>Review the information identified from the image before saving. You can correct any value that was not identified accurately.</p>
        </div>

        <EditForm Model="@draft" OnValidSubmit="SaveProduct">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Manufacturer</label>
                    <InputText class="form-control" @bind-Value="draft.Manufacturer" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Model Number</label>
                    <InputText class="form-control" @bind-Value="draft.ModelNumber" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Product Type</label>
                    <InputText class="form-control" @bind-Value="draft.ProductType" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Product Name</label>
                    <InputText class="form-control" @bind-Value="draft.ProductName" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Serial Number</label>
                    <InputText class="form-control" @bind-Value="draft.SerialNumber" />
                    <div class="form-text">Optional. Enter it manually if available.</div>
                </div>
            </div>

            <div class="pc-result mb-3">
                <span class="text-muted">AI confidence</span>
                <div class="fw-semibold mt-1">@result.Confidence</div>
            </div>

            <button type="submit" class="btn btn-primary pc-primary-button" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save Product")
            </button>

            @if (isSaving)
            {
                <div class="pc-loading mt-3" role="status" aria-live="polite">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Saving product...</span>
                </div>
            }
        </EditForm>
    </section>

    <section class="pc-panel mt-4">
        <h2 class="h5 mb-3">Text Observed in Image</h2>

        @if (result.ObservedText.Count == 0)
        {
            <div class="pc-empty-state">
                <p class="mb-0">No readable text was detected in the image.</p>
            </div>
        }
        else
        {
            <ul class="mb-0">
                @foreach (string text in result.ObservedText)
                {
                    <li class="mb-1">@text</li>
                }
            </ul>
        }
    </section>
}

@if (savedProduct is not null)
{
    <div class="pc-success mt-4" role="status" aria-live="polite">
        <strong>Product saved successfully.</strong>
        <div class="mt-1">The product is now available in My Products.</div>
    </div>
}

@code {
    private IBrowserFile? selectedFile;
    private ProductIdentificationResponse? result;
    private ProductResponse? savedProduct;
    private ProductDraft draft = new();
    private bool isIdentifying;
    private bool isSaving;
    private string? errorMessage;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;

        result = null;
        savedProduct = null;
        errorMessage = null;

        draft = new ProductDraft();
    }

    private async Task IdentifyProduct()
    {
        if (selectedFile is null)
        {
            return;
        }

        isIdentifying = true;

        result = null;
        savedProduct = null;
        errorMessage = null;

        try
        {
            result = await ApiClient.IdentifyProductAsync(selectedFile);

            if (result is not null)
            {
                draft = new ProductDraft
                {
                    Manufacturer = result.Manufacturer,
                    ModelNumber = result.ModelNumber,
                    ProductType = result.ProductType,
                    ProductName = result.ProductName
                };
            }
        }
        catch
        {
            errorMessage = "We couldn't identify this product. Try a clearer photo showing the manufacturer or model number.";
        }
        finally
        {
            isIdentifying = false;
        }
    }

    private async Task SaveProduct()
    {
        if (result is null)
        {
            return;
        }

        isSaving = true;
        savedProduct = null;
        errorMessage = null;

        try
        {
            CreateProductRequest request = new(draft.Manufacturer, draft.ModelNumber, draft.ProductType, draft.ProductName, draft.SerialNumber, result.Confidence);

            savedProduct = await ApiClient.CreateProductAsync(request);
        }
        catch
        {
            errorMessage = "The product could not be saved.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class ProductDraft
    {
        public string? Manufacturer { get; set; }
        public string? ModelNumber { get; set; }
        public string? ProductType { get; set; }
        public string? ProductName { get; set; }
        public string? SerialNumber { get; set; }
    }
}