@page "/products"

@using Microsoft.AspNetCore.Authorization
@using ProductCare.Web.Api

@attribute [Authorize]

@inject ProductCareApiClient ApiClient

<PageTitle>My Products | ProductCare AI</PageTitle>

<div class="pc-page-header pc-page-header-with-action">
    <div>
        <div class="pc-eyebrow">Product library</div>
        <h1>My Products</h1>
        <p>View the products saved to your ProductCare account and open one for AI-assisted support.</p>
    </div>

    <a class="btn btn-primary pc-primary-button" href="identify">Identify a product</a>
</div>

@if (isLoading)
{
    <section class="pc-panel">
        <div class="pc-loading" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading products...</span>
        </div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="pc-error" role="alert">
        @errorMessage
    </div>
}
else if (products.Count == 0)
{
    <section class="pc-panel">
        <div class="pc-empty-state">
            <div class="pc-empty-state-mark">PC</div>
            <h2>No products yet</h2>

            <p>
                Identify your first product to add it to ProductCare and start using product support features.
            </p>

            <a class="btn btn-primary pc-primary-button" href="identify">Identify a product</a>
        </div>
    </section>
}
else
{
    <section class="pc-panel">
        <div class="pc-products-header">
            <div>
                <div class="pc-eyebrow">Saved products</div>
                <h2>Your product library</h2>
                <p>@products.Count @(products.Count == 1 ? "product" : "products") saved</p>
            </div>

            <span class="pc-count-badge">@products.Count</span>
        </div>

        <div class="table-responsive pc-table-container">
            <table class="table pc-product-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Manufacturer</th>
                        <th scope="col">Model</th>
                        <th scope="col">Serial number</th>
                        <th scope="col">Added</th>
                        <th scope="col" class="pc-product-action-column"></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (ProductResponse product in products)
                    {
                        <tr>
                            <td>
                                <a class="pc-product-name" href="@($"/products/{product.Id}")">
                                    @DisplayProductName(product)
                                </a>

                                @if (!string.IsNullOrWhiteSpace(product.ProductType))
                                {
                                    <div class="pc-product-type">@product.ProductType</div>
                                }
                            </td>

                            <td>@Display(product.Manufacturer)</td>
                            <td>@Display(product.ModelNumber)</td>
                            <td>@Display(product.SerialNumber)</td>
                            <td>@product.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")</td>

                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/products/{product.Id}")">
                                    Open
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private IReadOnlyList<ProductResponse> products = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await ApiClient.GetProductsAsync();
        }
        catch
        {
            errorMessage = "Products could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string DisplayProductName(ProductResponse product)
    {
        if (!string.IsNullOrWhiteSpace(product.ProductName))
        {
            return product.ProductName;
        }

        if (!string.IsNullOrWhiteSpace(product.ProductType))
        {
            return product.ProductType;
        }

        return "Product";
    }
}