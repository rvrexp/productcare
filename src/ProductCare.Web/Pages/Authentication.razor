@page "/authentication/{action}"

@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

<PageTitle>Authentication | ProductCare AI</PageTitle>

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-7 col-md-9">
        <section class="pc-panel">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3"
                     style="width: 52px; height: 52px;">
                    <i class="bi bi-shield-lock fs-4" aria-hidden="true"></i>
                </div>

                <div class="pc-eyebrow">Secure access</div>
                <h1 class="h3 mb-2">ProductCare authentication</h1>

                <p class="text-muted mb-0">
                    Secure sign-in is provided through Microsoft Entra External ID.
                </p>
            </div>

            <RemoteAuthenticatorView Action="@Action" />
        </section>

        <p class="small text-muted text-center mt-3">
            Authentication credentials are handled by the identity provider and are not stored by ProductCare.
        </p>
    </div>
</div>

@code {
    [Parameter]
    public string Action { get; set; } = string.Empty;
}