@using Microsoft.AspNetCore.Components
@using ProductCare.Web.Api

@inject AccountLifecycleApiClient LifecycleApi
@inject NavigationManager Navigation

<section class="pc-panel mt-4 border border-danger-subtle">
    <div class="pc-section-header">
        <div>
            <div class="pc-eyebrow text-danger">
                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                Danger zone
            </div>
            <h2>Delete product</h2>
            <p>Deletes this product, its uploaded manual, indexed manual content, and its ProductCare assistant conversation.</p>
        </div>
    </div>

    @if (!confirming)
    {
        <button type="button" class="btn btn-outline-danger" @onclick="() => confirming = true">Delete product</button>
    }
    else
    {
        <div class="alert alert-warning">
            This action cannot be undone. The Microsoft Entra account is not affected.
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-danger" @onclick="DeleteAsync" disabled="@deleting">@(deleting ? "Deleting..." : "Delete permanently")</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@deleting">Cancel</button>
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid ProductId { get; set; }

    private bool confirming;
    private bool deleting;
    private string? error;

    private void Cancel()
    {
        confirming = false;
        error = null;
    }

    private async Task DeleteAsync()
    {
        deleting = true;
        error = null;

        try
        {
            await LifecycleApi.DeleteProductAsync(ProductId);
            Navigation.NavigateTo("/products");
        }
        catch
        {
            error = "ProductCare could not delete the product. No local product record was removed if dependent Azure resource cleanup failed.";
        }
        finally
        {
            deleting = false;
        }
    }
}
