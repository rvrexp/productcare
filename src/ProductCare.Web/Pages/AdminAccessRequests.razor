@page "/admin/access-requests"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ProductCare.Web.Access
@using ProductCare.Web.Api

@attribute [Authorize]

@inject UserAccessState AccessState
@inject ProductCareApiClient ApiClient

<PageTitle>Access Requests | ProductCare AI</PageTitle>

<div class="pc-page-header pc-page-header-with-action">
    <div>
        <div class="pc-eyebrow">Administration</div>
        <h1>Access requests</h1>
        <p>Review pending ProductCare demo access requests and control how long approved access remains active.</p>
    </div>

    @if (!isLoading && AccessState.IsAdmin && string.IsNullOrWhiteSpace(loadError))
    {
        <span class="badge rounded-pill text-bg-primary px-3 py-2">
            @requests.Count pending
        </span>
    }
</div>

@if (isLoading)
{
    <section class="pc-panel">
        <div class="pc-loading" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading access requests...</span>
        </div>
    </section>
}
else if (!AccessState.IsAdmin)
{
    <section class="pc-panel">
        <div class="pc-empty-state">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger mb-3"
                 style="width: 52px; height: 52px;">
                <i class="bi bi-shield-exclamation fs-4" aria-hidden="true"></i>
            </div>

            <div class="pc-eyebrow">Administrator access required</div>
            <h2>You don't have access to this area</h2>

            <p>
                Your account does not have permission to review ProductCare access requests.
            </p>

            <a class="btn btn-primary pc-primary-button" href="/">
                <i class="bi bi-house-door me-1" aria-hidden="true"></i>
                Go to Home
            </a>
        </div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="pc-error">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-circle mt-1" aria-hidden="true"></i>

            <div>
                <strong>Access requests could not be loaded.</strong>
                <div class="mt-1">@loadError</div>
            </div>
        </div>
    </div>
}
else if (requests.Count == 0)
{
    <section class="pc-panel">
        <div class="pc-empty-state">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mb-3"
                 style="width: 52px; height: 52px;">
                <i class="bi bi-check2-circle fs-4" aria-hidden="true"></i>
            </div>

            <div class="pc-eyebrow">Up to date</div>
            <h2>No pending requests</h2>

            <p>
                There are currently no ProductCare access requests waiting for review.
            </p>
        </div>
    </section>
}
else
{
    <div class="d-flex flex-column gap-4">
        @foreach (AdminAccessRequestViewModel item in requests)
        {
            <section class="pc-panel">
                <div class="row g-4">
                    <div class="col-xl-7">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                            <div>
                                <div class="pc-eyebrow">Pending request</div>
                                <h2 class="h4 mb-1">@GetRequesterName(item.Request)</h2>

                                <div class="text-muted small">
                                    <i class="bi bi-clock me-1" aria-hidden="true"></i>
                                    Requested @item.Request.RequestedUtc.ToLocalTime().ToString("MMMM d, yyyy 'at' h:mm tt")
                                </div>
                            </div>

                            <span class="badge text-bg-warning">Pending</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <span class="pc-meta-label">
                                    <i class="bi bi-envelope me-1" aria-hidden="true"></i>
                                    Email
                                </span>

                                <span class="pc-meta-value">
                                    @(item.Request.Email ?? "Not available")
                                </span>
                            </div>

                            <div class="col-md-6">
                                <span class="pc-meta-label">
                                    <i class="bi bi-building me-1" aria-hidden="true"></i>
                                    Organization / Company
                                </span>

                                <span class="pc-meta-value">
                                    @(string.IsNullOrWhiteSpace(item.Request.Organization) ? "Not provided" : item.Request.Organization)
                                </span>
                            </div>

                            <div class="col-12">
                                <span class="pc-meta-label">
                                    <i class="bi bi-bullseye me-1" aria-hidden="true"></i>
                                    Purpose
                                </span>

                                <span class="pc-meta-value">@item.Request.Purpose</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Request.Message))
                        {
                            <div class="mt-4">
                                <span class="pc-meta-label">
                                    <i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>
                                    Request message
                                </span>

                                <div class="border rounded-3 bg-light p-3 mt-2">
                                    <p class="mb-0">@item.Request.Message</p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-xl-5">
                        <div class="border rounded-3 bg-light p-4 h-100">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-calendar-check text-primary fs-5" aria-hidden="true"></i>
                                <h3 class="h6 mb-0">Access decision</h3>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    Access through
                                </label>

                                <InputDate class="form-control"
                                           @bind-Value="item.AccessThroughDate"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                                <div class="form-text">
                                    Approved access remains active through the end of the selected day in your local time.
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Error))
                            {
                                <div class="pc-error mb-3">
                                    <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
                                    @item.Error
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button type="button"
                                        class="btn btn-primary pc-primary-button"
                                        @onclick="() => Approve(item)"
                                        disabled="@item.IsProcessing">
                                    @if (item.IsProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                        <span>Processing...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                                        <span>Approve access</span>
                                    }
                                </button>

                                <button type="button"
                                        class="btn btn-outline-danger"
                                        @onclick="() => Reject(item)"
                                        disabled="@item.IsProcessing">
                                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>
                                    Reject request
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>
}

@code {
    private readonly List<AdminAccessRequestViewModel> requests = [];

    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AccessState.EnsureLoadedAsync();

            if (!AccessState.IsAdmin)
            {
                return;
            }

            IReadOnlyList<AdminAccessRequestResponse> pendingRequests = await ApiClient.GetPendingAccessRequestsAsync();

            requests.AddRange(pendingRequests.Select(request => new AdminAccessRequestViewModel(request)));
        }
        catch
        {
            loadError = "ProductCare could not retrieve the pending access requests.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Approve(AdminAccessRequestViewModel item)
    {
        item.Error = null;

        if (item.AccessThroughDate is null)
        {
            item.Error = "Select the date through which this user should have access.";
            return;
        }

        DateTime selectedDate = item.AccessThroughDate.Value.Date;

        if (selectedDate < DateTime.Today)
        {
            item.Error = "The access expiration date cannot be in the past.";
            return;
        }

        DateTime localExpiration = DateTime.SpecifyKind(selectedDate.AddDays(1).AddSeconds(-1), DateTimeKind.Local);
        DateTime accessExpiresUtc = localExpiration.ToUniversalTime();

        item.IsProcessing = true;

        try
        {
            await ApiClient.ApproveAccessRequestAsync(item.Request.Id, accessExpiresUtc);

            requests.Remove(item);
        }
        catch
        {
            item.Error = "ProductCare could not approve this access request.";
        }
        finally
        {
            item.IsProcessing = false;
        }
    }

    private async Task Reject(AdminAccessRequestViewModel item)
    {
        item.Error = null;
        item.IsProcessing = true;

        try
        {
            await ApiClient.RejectAccessRequestAsync(item.Request.Id);

            requests.Remove(item);
        }
        catch
        {
            item.Error = "ProductCare could not reject this access request.";
        }
        finally
        {
            item.IsProcessing = false;
        }
    }

    private static string GetRequesterName(AdminAccessRequestResponse request)
    {
        if (!string.IsNullOrWhiteSpace(request.DisplayName) &&
            !request.DisplayName.Equals("unknown", StringComparison.OrdinalIgnoreCase))
        {
            return request.DisplayName;
        }

        return request.Email ?? "ProductCare user";
    }

    private sealed class AdminAccessRequestViewModel
    {
        public AdminAccessRequestViewModel(AdminAccessRequestResponse request)
        {
            Request = request;
        }

        public AdminAccessRequestResponse Request { get; }

        public DateTime? AccessThroughDate { get; set; }

        public bool IsProcessing { get; set; }

        public string? Error { get; set; }
    }
}