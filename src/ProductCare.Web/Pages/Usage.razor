@page "/usage"

@using Microsoft.AspNetCore.Authorization
@using ProductCare.Web.Access
@using ProductCare.Web.Api
@using ProductCare.Web.Usage

@attribute [Authorize]

@inject UserAccessState AccessState
@inject UsageQuotaState UsageState

<PageTitle>AI Usage | ProductCare AI</PageTitle>

<div class="pc-page-header">
    <div>
        <div class="pc-eyebrow">Usage controls</div>
        <h1>Today's AI usage</h1>
        <p>Monitor the daily ProductCare AI limits available to this account.</p>
    </div>
</div>

@if (isLoading)
{
    <section class="pc-panel">
        <div class="pc-loading" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading usage information...</span>
        </div>
    </section>
}
else if (!AccessState.IsActive)
{
    <section class="pc-panel">
        <div class="pc-empty-state">
            <div class="pc-eyebrow">Access required</div>
            <h2>Active ProductCare access is required</h2>

            <p>
                AI usage information becomes available after ProductCare access has been approved.
            </p>

            <a class="btn btn-primary pc-primary-button" href="access">View access status</a>
        </div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="pc-error">
        <strong>Usage information could not be loaded.</strong>
        <div class="mt-1">@loadError</div>
    </div>
}
else if (UsageState.Summary is not null)
{
    <section class="pc-panel">
        <div class="pc-section-header">
            <div>
                <div class="pc-eyebrow">Daily limits</div>
                <h2>Available AI operations</h2>
                <p>Each AI capability has its own daily allowance for this account.</p>
            </div>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="RefreshUsage"
                    disabled="@isRefreshing">
                @(isRefreshing ? "Refreshing..." : "Refresh usage")
            </button>
        </div>

        <div class="pc-usage-grid pc-usage-grid-large">
            @foreach (UsageQuotaOperationResponse operation in UsageState.Summary.Operations)
            {
                int percentageRemaining = GetPercentageRemaining(operation);

                <article class="pc-usage-card pc-usage-card-detailed">
                    <div class="pc-usage-card-header">
                        <span>@operation.DisplayName</span>

                        <strong class="@GetRemainingTextClass(operation)">
                            @operation.Remaining / @operation.DailyLimit
                        </strong>
                    </div>

                    <div class="pc-usage-value">
                        @operation.Remaining
                    </div>

                    <div class="pc-usage-value-label">
                        requests remaining today
                    </div>

                    <div class="progress pc-progress" role="progressbar" aria-valuenow="@percentageRemaining" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @GetProgressClass(operation)" style="width: @(percentageRemaining)%"></div>
                    </div>

                    <div class="pc-usage-card-footer">
                        <span>@operation.Consumed used</span>
                        <span>@percentageRemaining% remaining</span>
                    </div>
                </article>
            }
        </div>

        <div class="pc-reset-panel">
            <div>
                <span class="pc-meta-label">Next daily reset</span>
                <strong>@UsageState.Summary.ResetUtc.ToLocalTime().ToString("MMMM d, yyyy 'at' h:mm tt")</strong>
            </div>

            <span>
                @UsageState.Summary.ResetUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")
            </span>
        </div>
    </section>
}

@code {
    private bool isLoading = true;
    private bool isRefreshing;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AccessState.EnsureLoadedAsync();

            if (AccessState.IsActive)
            {
                await UsageState.RefreshAsync();
            }
        }
        catch
        {
            loadError = "ProductCare could not retrieve your current AI usage.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshUsage()
    {
        isRefreshing = true;
        loadError = null;

        try
        {
            await UsageState.RefreshAsync();
        }
        catch
        {
            loadError = "ProductCare could not refresh your current AI usage.";
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private static int GetPercentageRemaining(UsageQuotaOperationResponse operation)
    {
        if (operation.DailyLimit <= 0)
        {
            return 0;
        }

        return Math.Clamp((int)Math.Round(operation.Remaining * 100d / operation.DailyLimit), 0, 100);
    }

    private static string GetProgressClass(UsageQuotaOperationResponse operation)
    {
        if (operation.Remaining == 0)
        {
            return "bg-danger";
        }

        return GetPercentageRemaining(operation) <= 20 ? "bg-warning" : "bg-success";
    }

    private static string GetRemainingTextClass(UsageQuotaOperationResponse operation)
    {
        if (operation.Remaining == 0)
        {
            return "text-danger";
        }

        return GetPercentageRemaining(operation) <= 20 ? "text-warning" : "";
    }
}