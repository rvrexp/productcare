@page "/access"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ProductCare.Web.Access
@using ProductCare.Web.Api
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims

@attribute [Authorize]

@inject UserAccessState AccessState
@inject ProductCareApiClient ApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Access | ProductCare AI</PageTitle>

<div class="pc-page-header">
    <div>
        <div class="pc-eyebrow">Demo Access</div>
        <h1>ProductCare access</h1>
        <p>ProductCare AI is a portfolio demonstration environment. Access is reviewed before AI and product-support features are enabled.</p>
    </div>
</div>

@if (isLoading)
{
    <div class="pc-loading">
        <p>Checking your access status...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="pc-error">
        <strong>Access status could not be loaded.</strong>
        <p>@loadError</p>
    </div>
}
else if (AccessState.IsActive)
{
    <section class="pc-panel">
        <div class="pc-eyebrow">Access Approved</div>
        <h2>Your ProductCare access is active</h2>

        <p>You can now use the ProductCare AI demonstration features.</p>

        @if (AccessState.Access?.AccessExpiresUtc is not null)
        {
            <p><strong>Demo access expires:</strong> @AccessState.Access.AccessExpiresUtc.Value.ToLocalTime().ToString("g")</p>
        }

        <div class="pc-actions">
            <a class="btn btn-primary pc-primary-button" href="identify">Identify a product</a>
            <a class="btn btn-outline-secondary" href="products">View my products</a>
        </div>
    </section>
}
else if (AccessState.IsPending)
{
    <section class="pc-panel">
        <div class="pc-eyebrow">Pending Review</div>
        <h2>Your access request is being reviewed</h2>

        <p>ProductCare access is manually reviewed before AI and product-support features are enabled.</p>

        @if (AccessState.Access?.RequestedUtc is not null)
        {
            <p><strong>Requested:</strong> @AccessState.Access.RequestedUtc.Value.ToLocalTime().ToString("g")</p>
        }

        <p>You will be notified by email after the request is reviewed.</p>

        <div class="pc-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="RefreshStatus" disabled="@isRefreshing">
                @(isRefreshing ? "Checking..." : "Refresh status")
            </button>

            <button type="button" class="btn btn-outline-secondary" @onclick="SignOut">
                Sign out
            </button>
        </div>
    </section>
}
else if (string.Equals(AccessState.Access?.Status, "Disabled", StringComparison.OrdinalIgnoreCase))
{
    <section class="pc-panel">
        <div class="pc-eyebrow">Access Unavailable</div>
        <h2>Your ProductCare access is disabled</h2>
        <p>This account cannot currently use ProductCare demonstration features.</p>
    </section>
}
else
{
    <section class="pc-panel">
        <div class="pc-eyebrow">Request Access</div>
        <h2>Request ProductCare demo access</h2>

        <p>
            Approved demo access can be used to identify products from images, save and manage products,
            ask questions grounded in product documentation, check official product recall information,
            and explore the ProductCare AI-assisted support workflow.
        </p>

        <div class="alert alert-info">
            <strong>Before requesting access</strong>
            <ul class="mb-0 mt-2">
                <li>This environment is provided for portfolio review and technical evaluation.</li>
                <li>Demo usage limits apply and access may expire.</li>
                <li>Use test or non-sensitive product information only.</li>
                <li>Do not upload confidential, proprietary, personal, or other sensitive information.</li>
                <li>Requests are manually reviewed before access is enabled.</li>
            </ul>
        </div>

        <EditForm Model="@requestModel" OnValidSubmit="SubmitRequest">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Signed-in email</label>
                <input class="form-control" value="@signedInEmail" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Organization / Company <span class="text-muted">(optional)</span></label>
                <InputText class="form-control" @bind-Value="requestModel.Organization" />
                <ValidationMessage For="@(() => requestModel.Organization)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Purpose</label>
                <InputSelect class="form-select" @bind-Value="requestModel.Purpose">
                    <option value="">Select a purpose</option>
                    <option value="Portfolio / Interview Review">Portfolio / Interview Review</option>
                    <option value="Technical Evaluation">Technical Evaluation</option>
                    <option value="Other">Other</option>
                </InputSelect>
                <ValidationMessage For="@(() => requestModel.Purpose)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Message <span class="text-muted">(optional)</span></label>
                <InputTextArea class="form-control" @bind-Value="requestModel.Message" rows="4" />
                <ValidationMessage For="@(() => requestModel.Message)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(submitError))
            {
                <div class="pc-error mb-3">@submitError</div>
            }

            <button type="submit" class="btn btn-primary pc-primary-button" disabled="@isSubmitting">
                @(isSubmitting ? "Submitting..." : "Request access")
            </button>
        </EditForm>
    </section>
}

@code {
    private readonly AccessRequestFormModel requestModel = new();

    private bool isLoading = true;
    private bool isSubmitting;
    private bool isRefreshing;
    private string? loadError;
    private string? submitError;
    private string signedInEmail = "Not available";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            signedInEmail = GetEmail(authenticationState.User) ?? "Not available";

            await AccessState.EnsureLoadedAsync();
        }
        catch
        {
            loadError = "ProductCare could not retrieve your current access information.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitRequest()
    {
        isSubmitting = true;
        submitError = null;

        try
        {
            SubmitAccessRequestRequest request = new(
                requestModel.Organization,
                requestModel.Purpose,
                requestModel.Message);

            await ApiClient.SubmitAccessRequestAsync(request);

            await AccessState.RefreshAsync();
        }
        catch
        {
            submitError = "ProductCare could not submit the access request. Refresh your status and try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task RefreshStatus()
    {
        isRefreshing = true;

        try
        {
            await AccessState.RefreshAsync();
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private void SignOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }

    private static string? GetEmail(ClaimsPrincipal user)
    {
        return user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.FindFirst("emails")?.Value
            ?? user.FindFirst("preferred_username")?.Value;
    }

    private sealed class AccessRequestFormModel
    {
        [StringLength(200)]
        public string? Organization { get; set; }

        [Required(ErrorMessage = "Select a purpose for requesting access.")]
        public string Purpose { get; set; } = string.Empty;

        [StringLength(2000)]
        public string? Message { get; set; }
    }
}