{
  "AzureAd": {
    //https://<tenant-name>.ciamlogin.com/<external-tenant-id>/v2.0  - where should the user be sent to sign in
    "Authority": "https://ProductCareApp.ciamlogin.com/91274844-f9a8-49c3-bacb-4028dcdca302/v2.0",
    // Application (client) ID of your Blazor frontend app registration
    "ClientId": "605b9338-a531-4e3f-ad88-e62d4193f58a",
    "ValidateAuthority": true, //should MSAL verify that the authority is a valid Microsoft identity authority
    "KnownAuthorities": [
      "ProductCareApp.ciamlogin.com"
    ]
  },

  //Blazor frontend wants permission to call the ProductCare API on behalf of the currently signed-in user
  "ProductCareApi": {
    "BaseUrl": "https://localhost:7148/",
    //"Scope": "api://<API-CLIENT-ID>/access_as_user"
    "Scope": "api://c5dd9bff-0258-4bc4-a8ea-4df434640a42/access_as_user"
  }
}