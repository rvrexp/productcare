@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@inject NavigationManager Navigation

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            <Authorizing>
                <section class="pc-panel">
                    <div class="pc-loading justify-content-center py-4" role="status" aria-live="polite">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Checking your account...</span>
                    </div>
                </section>
            </Authorizing>

            <NotAuthorized>
                <PageTitle>Sign In Required | ProductCare AI</PageTitle>

                <section class="pc-panel">
                    <div class="pc-empty-state">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3"
                             style="width: 56px; height: 56px;">
                            <i class="bi bi-person-lock fs-3" aria-hidden="true"></i>
                        </div>

                        <div class="pc-eyebrow">Authentication required</div>

                        <h1 class="h3 mb-2">
                            Sign in to continue
                        </h1>

                        <p class="mb-4">
                            You need to sign in before accessing this ProductCare feature.
                        </p>

                        <button type="button" class="btn btn-primary pc-primary-button" @onclick="SignIn">
                            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                            Sign in
                        </button>
                    </div>
                </section>
            </NotAuthorized>
        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>

    <NotFound>
        <PageTitle>Not Found | ProductCare AI</PageTitle>

        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <section class="pc-panel">
                <div class="pc-empty-state">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3"
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-compass fs-3" aria-hidden="true"></i>
                    </div>

                    <div class="pc-eyebrow">404 · Page not found</div>

                    <h1 class="h3 mb-2">
                        We couldn't find that page
                    </h1>

                    <p class="mb-4">
                        The page you requested does not exist, may have moved, or may no longer be available.
                    </p>

                    <a class="btn btn-primary pc-primary-button" href="/">
                        <i class="bi bi-house-door me-1" aria-hidden="true"></i>
                        Go to Home
                    </a>
                </div>
            </section>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private void SignIn()
    {
        InteractiveRequestOptions requestOptions = new()
        {
            Interaction = InteractionType.SignIn,
            ReturnUrl = Navigation.Uri
        };

        Navigation.NavigateToLogin("authentication/login", requestOptions);
    }
}