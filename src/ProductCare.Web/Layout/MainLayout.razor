@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Security.Claims

@inject NavigationManager Navigation

<div class="pc-shell">
    <aside class="pc-sidebar">
        <NavMenu />
    </aside>

    <div class="pc-main">
        <header class="pc-topbar">
            <div class="pc-topbar-context">
                <span class="pc-topbar-title">
                    <i class="bi bi-stars me-2 text-primary" aria-hidden="true"></i>
                    AI-powered product support
                </span>
                <span class="pc-topbar-subtitle">Identify, understand, and manage your products</span>
            </div>

            <AuthorizeView>
                <Authorized Context="authContext">
                    <div class="pc-user-area">
                        <div class="pc-user-chip">
                            <span class="pc-user-avatar">@GetInitial(authContext.User)</span>

                            <div class="pc-user-details">
                                <span class="pc-user-label">Signed in as</span>
                                <span class="pc-user-name">@GetUserDisplayName(authContext.User)</span>
                            </div>
                        </div>

                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SignOut">
                            <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>
                            Sign out
                        </button>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <button type="button" class="btn btn-sm btn-primary pc-primary-button" @onclick="SignIn">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                        Sign in
                    </button>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <main class="pc-content">
            @Body
        </main>
    </div>
</div>

@code {
    private static string GetUserDisplayName(ClaimsPrincipal user)
    {
        string? displayName = user.FindFirst("name")?.Value;

        if (string.IsNullOrWhiteSpace(displayName) || displayName.Equals("unknown", StringComparison.OrdinalIgnoreCase))
        {
            displayName = user.FindFirst("preferred_username")?.Value;
        }

        if (string.IsNullOrWhiteSpace(displayName) || displayName.Equals("unknown", StringComparison.OrdinalIgnoreCase))
        {
            displayName = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value;
        }

        return string.IsNullOrWhiteSpace(displayName) || displayName.Equals("unknown", StringComparison.OrdinalIgnoreCase) ? "Signed in" : displayName;
    }

    private static string GetInitial(ClaimsPrincipal user)
    {
        string displayName = GetUserDisplayName(user);

        return string.IsNullOrWhiteSpace(displayName) || displayName.Equals("Signed in", StringComparison.OrdinalIgnoreCase)
            ? "U"
            : displayName[..1].ToUpperInvariant();
    }

    private void SignIn()
    {
        Navigation.NavigateToLogin("authentication/login");
    }

    private void SignOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}