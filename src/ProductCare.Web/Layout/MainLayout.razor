@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Security.Claims

@inject NavigationManager Navigation

<div class="pc-shell">
    <aside class="pc-sidebar">
        <NavMenu />
    </aside>

    <div class="pc-main">
        <header class="pc-topbar">
            <span class="pc-topbar-title">AI-powered product support</span>

            <AuthorizeView>
                <Authorized Context="authContext">
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted">@GetUserDisplayName(authContext.User)</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SignOut">Sign out</button>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <button type="button" class="btn btn-sm btn-primary pc-primary-button" @onclick="SignIn">Sign in</button>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <main class="pc-content">
            @Body
        </main>
    </div>
</div>

@code {
    private static string GetUserDisplayName(ClaimsPrincipal user)
    {
        string? displayName = user.FindFirst("name")?.Value;

        if (string.IsNullOrWhiteSpace(displayName) || displayName.Equals("unknown", StringComparison.OrdinalIgnoreCase))
        {
            displayName = user.FindFirst("preferred_username")?.Value;
        }

        if (string.IsNullOrWhiteSpace(displayName) || displayName.Equals("unknown", StringComparison.OrdinalIgnoreCase))
        {
            displayName = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value;
        }

        return string.IsNullOrWhiteSpace(displayName) || displayName.Equals("unknown", StringComparison.OrdinalIgnoreCase) ? "Signed in" : displayName;
    }

    private void SignIn()
    {
        Navigation.NavigateToLogin("authentication/login");
    }

    private void SignOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}