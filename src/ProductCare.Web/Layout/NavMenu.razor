@using ProductCare.Web.Access
@implements IDisposable

@inject UserAccessState AccessState

<div class="pc-brand">
    <NavLink class="pc-brand-lockup text-decoration-none" href="" Match="NavLinkMatch.All">
        <span class="pc-brand-mark pc-brand-monogram" aria-hidden="true">
            PC
        </span>

        <div class="pc-brand-copy">
            <span class="pc-brand-name">ProductCare</span>
            <span class="pc-brand-ai">AI</span>
        </div>
    </NavLink>

    <button type="button"
            class="btn btn-sm btn-outline-light pc-menu-button"
            @onclick="ToggleMenu"
            aria-label="Toggle navigation">
        <i class="bi bi-list me-1" aria-hidden="true"></i>
        Menu
    </button>
</div>

<nav class="@NavCssClass">
    <div class="pc-nav-section-label">Overview</div>

    <NavLink class="pc-nav-link" href="" Match="NavLinkMatch.All">
        <i class="bi bi-house-door pc-nav-icon" aria-hidden="true"></i>
        <span>Home</span>
    </NavLink>

    <AuthorizeView>
        <Authorized>
            @if (AccessState.IsLoading || !AccessState.IsLoaded)
            {
                <div class="pc-nav-status" aria-live="polite">
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    Checking access...
                </div>
            }
            else
            {
                @if (AccessState.IsActive)
                {
                    <div class="pc-nav-section-label">Workspace</div>

                    <NavLink class="pc-nav-link" href="identify">
                        <i class="bi bi-camera pc-nav-icon" aria-hidden="true"></i>
                        <span>Identify Product</span>
                    </NavLink>

                    <NavLink class="pc-nav-link" href="products">
                        <i class="bi bi-boxes pc-nav-icon" aria-hidden="true"></i>
                        <span>My Products</span>
                    </NavLink>

                    <NavLink class="pc-nav-link" href="usage">
                        <i class="bi bi-bar-chart-line pc-nav-icon" aria-hidden="true"></i>
                        <span>AI Usage</span>
                    </NavLink>
                }

                <div class="pc-nav-section-label">Account</div>

                @if (!AccessState.IsActive)
                {
                    <NavLink class="pc-nav-link" href="access">
                        <i class="bi bi-person-check pc-nav-icon" aria-hidden="true"></i>
                        <span>Access</span>
                    </NavLink>
                }

                <NavLink class="pc-nav-link" href="account">
                    <i class="bi bi-person-gear pc-nav-icon" aria-hidden="true"></i>
                    <span>Account</span>
                </NavLink>

                @if (AccessState.IsAdmin)
                {
                    <div class="pc-nav-section-label">Administration</div>

                    <NavLink class="pc-nav-link" href="admin/access-requests">
                        <i class="bi bi-shield-check pc-nav-icon" aria-hidden="true"></i>
                        <span>Access Requests</span>
                    </NavLink>

                    <NavLink class="pc-nav-link" href="admin/users">
                        <i class="bi bi-people pc-nav-icon" aria-hidden="true"></i>
                        <span>Users</span>
                    </NavLink>
                }
            }
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private bool _menuOpen;

    private string NavCssClass => _menuOpen ? "pc-nav pc-nav-open" : "pc-nav";

    protected override async Task OnInitializedAsync()
    {
        AccessState.Changed += OnAccessChanged;

        try
        {
            await AccessState.EnsureLoadedAsync();
        }
        catch
        {
            // The Access page provides the detailed error and retry experience.
        }
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }

    private void OnAccessChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AccessState.Changed -= OnAccessChanged;
    }
}