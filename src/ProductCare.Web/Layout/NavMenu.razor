<div class="pc-brand">
    <span class="pc-brand-mark">PC</span>
    <span>ProductCare AI</span>

    <button type="button" class="btn btn-sm btn-outline-light pc-menu-button" @onclick="ToggleMenu" aria-label="Toggle navigation">
        Menu
    </button>
</div>

<nav class="@NavCssClass">
    <NavLink class="pc-nav-link" href="" Match="NavLinkMatch.All">
        Home
    </NavLink>

    <AuthorizeView>
        <Authorized>
            <NavLink class="pc-nav-link" href="identify">
                Identify Product
            </NavLink>

            <NavLink class="pc-nav-link" href="products">
                My Products
            </NavLink>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private bool _menuOpen;

    private string NavCssClass => _menuOpen ? "pc-nav pc-nav-open" : "pc-nav";

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }
}