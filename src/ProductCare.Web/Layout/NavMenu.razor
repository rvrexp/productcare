@using ProductCare.Web.Access
@implements IDisposable

@inject UserAccessState AccessState

<div class="pc-brand">
    <span class="pc-brand-mark">PC</span>
    <span>ProductCare AI</span>

    <button type="button" class="btn btn-sm btn-outline-light pc-menu-button" @onclick="ToggleMenu" aria-label="Toggle navigation">
        Menu
    </button>
</div>

<nav class="@NavCssClass">
    <NavLink class="pc-nav-link" href="" Match="NavLinkMatch.All">
        Home
    </NavLink>

    <AuthorizeView>
        <Authorized>
            @if (AccessState.IsLoading || !AccessState.IsLoaded)
            {
                <div class="pc-nav-link text-muted" aria-live="polite">
                    Checking access...
                </div>
            }
            else
            {
                @if (AccessState.IsActive)
                {
                    <NavLink class="pc-nav-link" href="identify">
                        Identify Product
                    </NavLink>

                    <NavLink class="pc-nav-link" href="products">
                        My Products
                    </NavLink>

                    <NavLink class="pc-nav-link" href="usage">
                        AI Usage
                    </NavLink>
                }
                else
                {
                    <NavLink class="pc-nav-link" href="access">
                        Access
                    </NavLink>
                }

                @if (AccessState.IsAdmin)
                {
                    <NavLink class="pc-nav-link" href="admin/access-requests">
                        Access Requests
                    </NavLink>
                }
            }
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private bool _menuOpen;

    private string NavCssClass => _menuOpen ? "pc-nav pc-nav-open" : "pc-nav";

    protected override async Task OnInitializedAsync()
    {
        AccessState.Changed += OnAccessChanged;

        try
        {
            await AccessState.EnsureLoadedAsync();
        }
        catch
        {
            // The Access page provides the detailed error and retry experience.
        }
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }

    private void OnAccessChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AccessState.Changed -= OnAccessChanged;
    }
}